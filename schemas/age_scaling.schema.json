{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://htma-decision-matrix/schemas/age_scaling.schema.json",
  "title": "HTMA Kids Matrix v2 — age_scaling rules",
  "description": "Schema for matrix/age_scaling/age_scaling.yml. Loaded by htma_decision_matrix.age_scaling at runtime; validated by tests/test_yaml_validity.py.",
  "type": "object",
  "required": [
    "version",
    "description",
    "anchor_curve",
    "fraction_ladder",
    "age_gates",
    "calmag_skew",
    "noon_handling",
    "dosing_schedule",
    "fraction_symbols",
    "dose_string_parsing"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semver of the age_scaling rules. Bump when changing locked rules."
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of the rules."
    },
    "anchor_curve": {
      "type": "object",
      "required": ["description", "points", "adult_threshold", "newborn_threshold"],
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string"},
        "points": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["age", "factor"],
            "additionalProperties": false,
            "properties": {
              "age": {"type": "number", "minimum": 0},
              "factor": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        },
        "adult_threshold": {
          "type": "integer",
          "minimum": 1,
          "description": "Age >= this is treated as adult (factor = 1.0)."
        },
        "newborn_threshold": {
          "type": "integer",
          "maximum": 0,
          "description": "Age <= this returns factor = 0.0."
        }
      }
    },
    "fraction_ladder": {
      "type": "object",
      "required": ["description", "thresholds"],
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string"},
        "thresholds": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["if_below", "floor_to"],
            "additionalProperties": false,
            "properties": {
              "if_below": {
                "oneOf": [
                  {"type": "number", "minimum": 0},
                  {"type": "null"}
                ]
              },
              "floor_to": {
                "oneOf": [
                  {"type": "number", "minimum": 0},
                  {"type": "string"}
                ]
              }
            }
          }
        }
      }
    },
    "age_gates": {
      "type": "object",
      "required": ["description", "products"],
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string"},
        "products": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0},
          "description": "product_id -> minimum age (integer years)."
        }
      }
    },
    "calmag_skew": {
      "type": "object",
      "required": ["description", "factor", "applies_to"],
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string"},
        "factor": {"type": "number", "minimum": 1.0},
        "applies_to": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        }
      }
    },
    "noon_handling": {
      "type": "object",
      "required": ["description", "merge_rule"],
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string"},
        "merge_rule": {
          "type": "string",
          "enum": ["max", "sum", "am", "pm"]
        }
      }
    },
    "dosing_schedule": {
      "type": "object",
      "required": ["description", "adult_slots", "kid_slots"],
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string"},
        "adult_slots": {
          "type": "array",
          "items": {"type": "string", "enum": ["am", "noon", "pm"]}
        },
        "kid_slots": {
          "type": "array",
          "items": {"type": "string", "enum": ["am", "noon", "pm"]}
        }
      }
    },
    "fraction_symbols": {
      "type": "object",
      "required": ["description", "map"],
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string"},
        "map": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "number"}
        }
      }
    },
    "dose_string_parsing": {
      "type": "object",
      "required": ["description", "zero_values", "cap_word_singular", "cap_word_plural"],
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string"},
        "zero_values": {
          "type": "array",
          "items": {"type": "string"}
        },
        "cap_word_singular": {"type": "string"},
        "cap_word_plural": {"type": "string"},
        "mixed_number_pattern": {"type": "string"}
      }
    }
  }
}
