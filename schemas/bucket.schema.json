{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://htma-decision-matrix.local/schemas/bucket.schema.json",
  "title": "HTMA Supplement Bucket",
  "description": "Validates one of the 6 supplement bucket YAML files.",
  "type": "object",
  "required": ["bucket_id", "label", "oxidation", "na_k_band", "products", "references"],
  "additionalProperties": true,
  "properties": {
    "bucket_id": {
      "type": "string",
      "enum": [
        "slow_high_nak",
        "slow_low_nak",
        "fast_high_nak",
        "fast_low_nak",
        "three_lows_high_nak",
        "three_lows_low_nak",
        "four_lows_high_nak",
        "four_lows_low_nak"
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "oxidation": {
      "type": "string",
      "enum": ["slow", "fast", "mixed", "three_lows", "four_lows"]
    },
    "na_k_band": {
      "type": "string",
      "enum": ["above_2.5", "below_2.5"]
    },
    "description": {"type": "string"},
    "adult_dose_overrides": {
      "type": "object",
      "description": "Per-product Adult (am·noon·pm) overrides for this bucket. Each value is {am, noon, pm} dose strings. Products not listed fall through to matrix/standard_protocols.yml.",
      "additionalProperties": {
        "type": "object",
        "required": ["am", "noon", "pm"],
        "additionalProperties": false,
        "properties": {
          "am": {"type": "string"},
          "noon": {"type": "string"},
          "pm": {"type": "string"}
        }
      }
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role"],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "slowox",
              "thyro-spark",
              "adrenofuel",
              "fast-oxidizer",
              "fastcalm",
              "valence-fastcalm",
              "cal-mag-fusion",
              "zinc-matrix-pro",
              "na-k-up",
              "bile-flow-plus",
              "cell-restore",
              "valence-d3-k2",
              "kelp-max",
              "nerv-calm",
              "red-pilled-sockeye",
              "valence-se",
              "kidney-flow"
            ]
          },
          "role": {"type": "string", "minLength": 1},
          "dose_modifier": {
            "type": "string",
            "enum": ["standard", "lower", "higher", "avoid"]
          },
          "dose_schedule": {
            "type": "object",
            "required": ["type", "metric", "anchors"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": ["linear"]
              },
              "metric": {
                "type": "string",
                "enum": ["na_k"]
              },
              "anchors": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": ["na_k_max", "dose"],
                  "additionalProperties": false,
                  "properties": {
                    "na_k_max": {
                      "oneOf": [
                        {"type": "number", "exclusiveMinimum": 0},
                        {"type": "null"}
                      ]
                    },
                    "dose": {
                      "type": "object",
                      "required": ["am", "noon", "pm"],
                      "additionalProperties": false,
                      "properties": {
                        "am": {"type": "string"},
                        "noon": {"type": "string"},
                        "pm": {"type": "string"}
                      }
                    }
                  }
                }
              }
            }
          },
          "notes": {"type": "string"},
          "conditional": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "description": {"type": "string"},
              "na_k_max": {"type": "number"},
              "na_k_min": {"type": "number"}
            }
          }
        },
        "anyOf": [
          {"required": ["dose_modifier"]},
          {"required": ["dose_schedule"]}
        ]
      }
    },
    "references": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
