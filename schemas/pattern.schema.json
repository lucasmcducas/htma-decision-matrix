{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://htma-decision-matrix.local/schemas/pattern.schema.json",
  "title": "HTMA Interpretation Pattern",
  "description": "Validates one interpretation pattern YAML. Patterns are annotation-only by default and never modify the bucket's product list.",
  "type": "object",
  "required": ["pattern_id", "display_name", "affects", "classifier", "references"],
  "additionalProperties": true,
  "properties": {
    "pattern_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9_]+$"
    },
    "display_name": {"type": "string", "minLength": 1},
    "affects": {
      "type": "string",
      "enum": ["classification", "annotation_only", "annotation_and_override"]
    },
    "description": {"type": "string"},
    "classifier": {
      "type": "object",
      "required": ["input", "rules"],
      "additionalProperties": true,
      "properties": {
        "input": {
          "type": "array",
          "items": {"type": "string"}
        },
        "evaluation_order": {
          "type": "array",
          "items": {"type": "string"}
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": true,
            "properties": {
              "id": {"type": "string"},
              "when": {"type": "object"},
              "when_any": {
                "type": "array",
                "items": {"type": "object"}
              },
              "note": {"type": "string"},
              "severity": {"type": "object"},
              "severity_note": {"type": "string"},
              "resolution": {"type": "string"}
            },
            "anyOf": [
              {"required": ["when"]},
              {"required": ["when_any"]}
            ]
          }
        },
        "indicators": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "when"],
            "additionalProperties": true,
            "properties": {
              "id": {"type": "string"},
              "when": {"type": "object"}
            }
          }
        }
      }
    },
    "sub_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id"],
        "properties": {
          "id": {"type": "string"},
          "when": {"type": "object"},
          "note": {"type": "string"}
        }
      }
    },
    "chart_annotations": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "reinforcing_combinations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "crash_landing_protocol": {
      "type": "object",
      "additionalProperties": true
    },
    "lab_caveats": {
      "type": "array",
      "items": {"type": "string"}
    },
    "retest_note": {"type": "string"},
    "references": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
